INSERT INTO DIARY VALUES(625,'2025-07-23 12:29:04','<html><head><meta content="text/html;charset=UTF-8"/></head><body><h1>\u041f\u0440\u0438\u043c\u0435\u0440 MERGE \u043f\u0440\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u043d\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0434\u0432\u0443\u043c \u043f\u043e\u043b\u044f\u043c</h1><hr/></body></html>','\u041f\u0440\u0438\u043c\u0435\u0440 MERGE \u043f\u0440\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u043d\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0434\u0432\u0443\u043c \u043f\u043e\u043b\u044f\u043c')
ALTER SEQUENCE PUBLIC.HIBERNATE_SEQUENCE RESTART WITH 626
