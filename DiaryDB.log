INSERT INTO DIARY VALUES(625,'2025-07-23 12:29:04','<html>\u000a<head>\u000a<meta content="text/html;charset=UTF-8"/>\u000a</head>\u000a<body>\u000a<h1>\u041f\u0440\u0438\u043c\u0435\u0440 MERGE \u043f\u0440\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u043d\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0434\u0432\u0443\u043c \u043f\u043e\u043b\u044f\u043c</h1>\u000a<hr/>\u000a\u000a<pre><code class="lang-sql"><span class="hljs-keyword">MERGE</span> <span class="hljs-keyword">INTO</span> control_status <span class="hljs-keyword">AS</span> t\u000a<span class="hljs-keyword">USING</span> (\u000a    <span class="hljs-keyword">VALUES</span> (:<span class="hljs-keyword">version</span>, :controlType, :<span class="hljs-keyword">status</span>, :inFinalStatus, :taskId, :completed)\u000a) <span class="hljs-keyword">AS</span> s (<span class="hljs-keyword">version</span>, control_type, <span class="hljs-keyword">status</span>, in_final_status, task_id, completed)\u000a<span class="hljs-keyword">ON</span> s.control_type = t.control_type <span class="hljs-keyword">and</span> s.task_id = t.task_id\u000a<span class="hljs-keyword">WHEN</span> <span class="hljs-keyword">MATCHED</span> <span class="hljs-keyword">AND</span> s.version <span class="hljs-keyword">IS</span> <span class="hljs-keyword">NOT</span> <span class="hljs-literal">NULL</span> <span class="hljs-keyword">AND</span> s.version &gt; t.version <span class="hljs-keyword">THEN</span>\u000a    <span class="hljs-keyword">UPDATE</span> <span class="hljs-keyword">SET</span>\u000a        <span class="hljs-keyword">version</span> = s.version,\u000a        <span class="hljs-keyword">status</span> = s.status,\u000a        in_final_status = s.in_final_status,\u000a        completed = s.completed\u000a<span class="hljs-keyword">WHEN</span> <span class="hljs-keyword">NOT</span> <span class="hljs-keyword">MATCHED</span> <span class="hljs-keyword">THEN</span>\u000a    <span class="hljs-keyword">INSERT</span> (<span class="hljs-keyword">version</span>, control_type, <span class="hljs-keyword">status</span>, in_final_status, task_id, completed)\u000a    <span class="hljs-keyword">VALUES</span> (s.version, s.control_type, s.status, s.in_final_status, s.task_id, s.completed)\u000a</code></pre>\u000a\u000a</body>\u000a</html>','\u041f\u0440\u0438\u043c\u0435\u0440 MERGE \u043f\u0440\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0438 \u043d\u0430 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0434\u0432\u0443\u043c \u043f\u043e\u043b\u044f\u043c')
COMMIT
