INSERT INTO DIARY VALUES(626,'2025-07-23 12:34:31','<html>\u000a<head>\u000a<meta content="text/html;charset=UTF-8"/>\u000a</head>\u000a<body>\u000a<h1>\u041f\u0435\u0440\u0435\u0432\u043e\u0434 Instant \u0432 Long</h1>\u000a<hr/>\u000a\u000a<pre><code class="lang-java">public Long getVersion(Instant updated, Instant created) {\u000a    Instant instant = Optional.ofNullable(updated)\u000a        .<span class="hljs-keyword">or</span><span class="hljs-function"><span class="hljs-params">(() -&gt; Optional.ofNullable(created))</span>\u000a        .<span class="hljs-title">orElseGet</span><span class="hljs-params">(Instant::now)</span>;\u000a    <span class="hljs-title">return</span> <span class="hljs-title">instant</span>.<span class="hljs-title">getEpochSecond</span><span class="hljs-params">()</span> * 1<span class="hljs-title">_000_000_000L</span> + <span class="hljs-title">instant</span>.<span class="hljs-title">getNano</span><span class="hljs-params">()</span>;\u000a}</span>\u000a</code></pre>\u000a\u000a</body>\u000a</html>','\u041f\u0435\u0440\u0435\u0432\u043e\u0434 Instant \u0432 Long')
COMMIT
